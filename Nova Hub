local function SetPage(Page)

    CurrentPage = Page

    for Name,Rows in pairs(Pages) do

        local Visible =
            Name == Page

        for _,Row in ipairs(Rows) do

            if Row and Row.Parent then

                Row.Visible = Visible

            end

        end

    end

    PageTitle.Text =
        PageNames[Page] or Page

    --------------------------------------------------------
    -- TAB COLORS
    --------------------------------------------------------

    for Name,Button in pairs(TabButtons) do

        if Button and Button.Parent then

            if Name == Page then

                Tween(
                    Button,
                    {
                        BackgroundColor3 =
                            Accent(),

                        TextColor3 =
                            Color3.new(1,1,1)
