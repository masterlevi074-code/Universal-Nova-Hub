local Tabs = {}

local function MakeTab(
    Name,
    Text,
    Y
)

    local Button =
        Instance.new("TextButton")

    Button.Name = Name.."Tab"

    Button.Size =
        UDim2.fromOffset(
            40,
            38
        )

    Button.Position =
        UDim2.fromOffset(
            10,
            Y
        )

    Button.BackgroundColor3 =
        Color3.fromRGB(17,18,23)

    Button.Text = Text

    Button.TextColor3 =
        Color3.fromRGB(130,133,143)

    Button.TextSize = 17

    Button.Font =
        Enum.Font.GothamBold

    Button.AutoButtonColor = false
    Button.Parent = Sidebar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0,9)
    Corner.Parent = Button

    Button.MouseEnter:Connect(function()

        if CurrentPage ~= Name then

            Tween(
                Button,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(27,29,37),

                    TextColor3 =
                        Color3.new(1,1,1)
                }
            )

        end
    end)

    Button.MouseLeave:Connect(function()

        if CurrentPage ~= Name then

            Tween(
                Button,
                {
                    BackgroundColor3 =
                        Color3.fromRGB(17,18,23),

                    TextColor3 =
                        Color3.fromRGB(130,133,143)
                }
            )

        end
    end)

    Button.MouseButton1Click:Connect(function()

        ShowPage(Name)

        for TabName,Tab in pairs(Tabs) do

            if TabName == Name then

                Tween(
                    Tab,
                    {
                        BackgroundColor3 =
                            Accent(),

                        TextColor3 =
                            Color3.new(1,1,1)
                    }
                )

            else

                Tween(
                    Tab,
                    {
                        BackgroundColor3 =
                            Color3.fromRGB(17,18,23),

                        TextColor3 =
                            Color3.fromRGB(130,133,143)
                    }
                )

            end
        end
    end)

    Tabs[Name] = Button

    return Button
end

