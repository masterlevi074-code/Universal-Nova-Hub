local function HideAll()
    for _,Row in ipairs(AimRows) do Row.Visible = false end
    for _,Row in ipairs(VisualRows) do Row.Visible = false end
    for _,Row in ipairs(HUDRows) do Row.Visible = false end
    for _,Row in ipairs(SettingsRows) do Row.Visible = false end
end

local function AnimatePage()
    Scroll.Position = UDim2.fromOffset(25,45)
    Tween(Scroll,{Position = UDim2.fromOffset(11,45)}, TweenSmooth)
end

local function ShowAim()
