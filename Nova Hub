local function Slider(
    Parent,
    Title,
    Min,
    Max,
    Value,
    Callback,
    Format
)

    local Row = Instance.new("Frame")

    Row.Size = UDim2.new(1,-2,0,54)
    Row.BackgroundColor3 = PanelColor()
    Row.BorderSizePixel = 0
    Row.Parent = Parent

    Instance.new("UICorner",Row).CornerRadius =
