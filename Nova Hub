-- We'll move the whole Main down by 220 pixels (off-screen feel) when minimizing.
local function MinimizeHub()
    ClosePopup()
    MainDragging = false
    HUDDragging = false

    if Config.UI.Animations then
        -- fade header text and content slightly while animating
        Tween(HeaderTitle, {TextTransparency = 1}, TweenFast)
        Tween(HeaderSub, {TextTransparency = 1}, TweenFast)
        Tween(PageTitle, {TextTransparency = 1}, TweenFast)
        local tw = Tween(Main, {Size = UDim2.fromOffset(365,0), Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset, Main.Position.Y.Scale, Main.Position.Y.Offset + 220)}, TweenSmooth)
        if tw then
            tw.Completed:Connect(function()
                if Main and Main.Parent then
                    Main.Visible = false
                    -- reset position/size so future open behaves
                    Main.Size = UDim2.fromOffset(365,300)
                    Main.Position = UDim2.new(.5,-182,.5,-150)
                    -- restore text transparency to visible for next open
                    HeaderTitle.TextTransparency = 0
                    HeaderSub.TextTransparency = 0
                    PageTitle.TextTransparency = 0
                    Mini.Visible = true
                end
            end)
        else
            Main.Visible = false
            Main.Position = UDim2.new(.5,-182,.5,-150)
            Mini.Visible = true
        end
    else
        Main.Visible = false
        Mini.Visible = true
    end
end

Minimize.MouseButton1Click:Connect(MinimizeHub)
Close.MouseButton1Click:Connect(MinimizeHub)

Mini.MouseButton1Click:Connect(function()
    -- restore
    Mini.Visible = false
    Main.Visible = true
    if Config.UI.Animations then
        -- start below and animate to center
        Main.Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset, Main.Position.Y.Scale, Main.Position.Y.Offset + 220)
        Main.Size = UDim2.fromOffset(365,0)
        Tween(HeaderTitle, {TextTransparency = 1}, TweenFast)
        Tween(HeaderSub, {TextTransparency = 1}, TweenFast)
        Tween(PageTitle, {TextTransparency = 1}, TweenFast)
        local tw = Tween(Main, {Size = UDim2.fromOffset(365,300), Position = UDim2.new(.5,-182,.5,-150)}, TweenSmooth)
        if tw then
            tw.Completed:Connect(function()
                if Main and Main.Parent then
                    Tween(HeaderTitle, {TextTransparency = 0}, TweenFast)
                    Tween(HeaderSub, {TextTransparency = 0}, TweenFast)
                    Tween(PageTitle, {TextTransparency = 0}, TweenFast)
                end
            end)
        end
    else
        Main.Size = UDim2.fromOffset(365,300)
        Main.Position = UDim2.new(.5,-182,.5,-150)
    end
end)

------------------------------------------------------------
-- FPS / HUD update loop
------------------------------------------------------------

local Frames = 0
local Elapsed = 0
local FPS = 60

RunService.RenderStepped:Connect(function(DT)
    Frames += 1
    Elapsed += DT
    if Elapsed >= 1 then
        FPS = Frames
        Frames = 0
        Elapsed = 0
    end

    if not Config.HUD.Enabled then return end
    local Lines = {}

    if Config.HUD.FPS then table.insert(Lines, "FPS: "..FPS) end
    if Config.HUD.Ping then
        local Ping = "?"
        pcall(function()
            Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        table.insert(Lines, "Ping: "..Ping.."ms")
    end
    if Config.HUD.Players then table.insert(Lines, "Players: "..#Players:GetPlayers()) end
    if Config.HUD.XYZ then
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if Root then
            local Position = Root.Position
            table.insert(Lines, string.format("XYZ: %.0f, %.0f, %.0f", Position.X, Position.Y, Position.Z))
        end
    end

    HUDText.Text = table.concat(Lines, "\n")
end)

