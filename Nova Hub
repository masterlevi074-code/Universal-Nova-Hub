-- NOVA HUB - SKELETON ESP FIXED
-- LocalScript (replace existing "Nova Hub" file)
-- Este script implementa um Skeleton ESP robusto que não quebra após teleporte/respawn.
-- Coloque como LocalScript em StarterPlayer > StarterPlayerScripts (ou substitua o arquivo "Nova Hub" no repo).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
if not localPlayer then
    Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    localPlayer = Players.LocalPlayer
end

-- Configurações
local ENABLED = true
local LINE_THICKNESS = 0.08
local LINE_TRANSPARENCY = 0.35
local LINE_COLOR = Color3.fromRGB(255, 255, 255) -- branco
local MAX_DISTANCE = 1500 -- distância máxima para desenhar linhas

-- Pares de ossos para R15 e R6
local BONE_PAIRS_R15 = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"},
}

local BONE_PAIRS_R6 = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Left Arm", "Left Leg"},
    {"Torso", "Right Arm"},
    {"Right Arm", "Right Leg"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

-- Utility para criar uma Part que funciona como linha
local function createLinePart()
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.Size = Vector3.new(LINE_THICKNESS, 1, LINE_THICKNESS)
    p.Transparency = LINE_TRANSPARENCY
    p.Shape = Enum.PartType.Block
    p.Color = LINE_COLOR
    p.CastShadow = false
    p.Name = "SkeletonLine"
    p.Parent = workspace
    return p
end

local function updateLinePart(part, aPos, bPos)
    local dir = bPos - aPos
    local mid = aPos + dir * 0.5
    local len = dir.Magnitude

    if len <= 0.001 then
        part.Transparency = 1
        return
    end

    part.Size = Vector3.new(LINE_THICKNESS, len, LINE_THICKNESS)
    local cf = CFrame.new(mid, bPos) * CFrame.Angles(math.pi/2, 0, 0)
    part.CFrame = cf
    part.Transparency = LINE_TRANSPARENCY
end

local function safeDestroy(obj)
    if obj and obj.Destroy then
        pcall(function() obj:Destroy() end)
    end
end

-- Cria ESP para um Character e retorna função de cleanup
local function createSkeletonForCharacter(character)
    if not character then return function() end end

    local lines = {}
    local renderConn
    local alive = true

    local function choosePairs()
        if character:FindFirstChild("UpperTorso") or character:FindFirstChild("LowerTorso") or character:FindFirstChild("RightUpperArm") then
            return BONE_PAIRS_R15
        else
            return BONE_PAIRS_R6
        end
    end

    local bonePairs = choosePairs()

    for i = 1, #bonePairs do
        local lp = createLinePart()
        table.insert(lines, lp)
    end

    renderConn = RunService.RenderStepped:Connect(function()
        if not ENABLED then
            for _, l in ipairs(lines) do
                if l and l.Parent then l.Transparency = 1 end
            end
            return
        end

        if not character or not character.Parent then
            alive = false
            return
        end

        local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character.PrimaryPart
        if not hrp then
            return
        end

        local cam = workspace.CurrentCamera
        local camPos = cam and cam.CFrame.Position or hrp.Position

        for i, pair in ipairs(bonePairs) do
            local aName = pair[1]
            local bName = pair[2]
            local aPart = character:FindFirstChild(aName)
            local bPart = character:FindFirstChild(bName)

            local line = lines[i]
            if aPart and bPart and line and line.Parent then
                local aPos = aPart:IsA("BasePart") and aPart.Position or (aPart.PrimaryPart and aPart.PrimaryPart.Position)
                local bPos = bPart:IsA("BasePart") and bPart.Position or (bPart.PrimaryPart and bPart.PrimaryPart.Position)

                if aPos and bPos then
                    if (aPos - camPos).Magnitude <= MAX_DISTANCE or (bPos - camPos).Magnitude <= MAX_DISTANCE then
                        updateLinePart(line, aPos, bPos)
                    else
                        line.Transparency = 1
                    end
                else
                    line.Transparency = 1
                end
            else
                if line and line.Parent then
                    line.Transparency = 1
                end
            end
        end
    end)

    local ancestryConn
    ancestryConn = character.AncestryChanged:Connect(function(_, parent)
        if not parent then
            alive = false
        end
    end)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local diedConn
    if humanoid then
        diedConn = humanoid.Died:Connect(function()
            alive = false
        end)
    end

    local function cleanup()
        if renderConn then
            pcall(function() renderConn:Disconnect() end)
            renderConn = nil
        end
        if ancestryConn then
            pcall(function() ancestryConn:Disconnect() end)
            ancestryConn = nil
        end
        if diedConn then
            pcall(function() diedConn:Disconnect() end)
            diedConn = nil
        end

        for _, l in ipairs(lines) do
            safeDestroy(l)
        end
        lines = {}
    end

    spawn(function()
        while alive do
            wait(0.5)
        end
        cleanup()
    end)

    return cleanup
end

-- Gerência do ciclo de vida do player
local currentCleanup = nil
local function onCharacterAdded(character)
    if currentCleanup then
        pcall(currentCleanup)
        currentCleanup = nil
    end

    pcall(function()
        character:WaitForChild("Humanoid", 3)
    end)

    currentCleanup = createSkeletonForCharacter(character)
end

if localPlayer.Character then
    onCharacterAdded(localPlayer.Character)
end

local charConn = localPlayer.CharacterAdded:Connect(onCharacterAdded)

Players.PlayerRemoving:Connect(function(p)
    if p == localPlayer then
        if charConn then pcall(function() charConn:Disconnect() end) end
        if currentCleanup then pcall(currentCleanup) end
    end
end)

-- Opcional: toggle global
getgenv = rawget(_G, "getgenv") and getgenv or function() return _G end
local env = getgenv()
env.SkeletonESPEnabled = env.SkeletonESPEnabled or ENABLED

spawn(function()
    while true do
        local desired = env.SkeletonESPEnabled
        if desired ~= ENABLED then
            ENABLED = desired
        end
        wait(0.5)
    end
end)
