-- Flag para evitar múltiplos cliques durante animação
local IsAnimating = false

local function MinimizeHub()

    if IsAnimating then return end
    IsAnimating = true

    ClosePopup()
    MainDragging = false
    HUDDragging = false

    if Config.UI.Animations then
        -- Anima o Main encolhendo (escala e opacidade)
        Main.AnchorPoint = Vector2.new(0.5, 0.5)
        Main.Position = UDim2.new(0.5, 0, 0.5, 0)
        
        Tween(Main, {
            Size = UDim2.fromOffset(0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }, TweenFast)
        
        -- Mostra o Mini com animação de bounce
        task.wait(0.15)
        Mini.Visible = true
        Main.Visible = false
        
        Mini.Size = UDim2.fromOffset(0, 0)
        Mini.Position = UDim2.new(0, 18, 0.5, -23)
        Mini.AnchorPoint = Vector2.new(0.5, 0.5)
        
        Tween(Mini, {
            Size = UDim2.fromOffset(46, 46)
        }, TweenBounce)
        
        -- Reseta o Main para quando for reaberto
        task.wait(0.4)
        Main.Size = UDim2.fromOffset(365, 300)
        Main.Position = UDim2.new(0.5, -182, 0.5, -150)
        Main.AnchorPoint = Vector2.new(0, 0)
        IsAnimating = false
        
    else
        -- Sem animação
        Main.Visible = false
        Mini.Visible = true
        IsAnimating = false
    end
end

Minimize.MouseButton1Click:Connect(MinimizeHub)
Close.MouseButton1Click:Connect(MinimizeHub)

Mini.MouseButton1Click:Connect(function()

    if IsAnimating then return end
    IsAnimating = true

    if Config.UI.Animations then
        -- Anima o Mini sumindo
        Tween(Mini, {
            Size = UDim2.fromOffset(0, 0)
        }, TweenFast)
        
        task.wait(0.15)
        Mini.Visible = false
        
        -- Mostra o Main com animação de spring (elástico)
        Main.Visible = true
        Main.Size = UDim2.fromOffset(0, 0)
        Main.AnchorPoint = Vector2.new(0.5, 0.5)
        Main.Position = UDim2.new(0.5, 0, 0.5, 0)
        
        Tween(Main, {
            Size = UDim2.fromOffset(365, 300)
        }, TweenSpring)
        
        task.wait(0.5)
        Main.Position = UDim2.new(0.5, -182, 0.5, -150)
        Main.AnchorPoint = Vector2.new(0, 0)
        IsAnimating = false
        
    else
        -- Sem animação
        Mini.Visible = false
        Main.Visible = true
        Main.Size = UDim2.fromOffset(365, 300)
        IsAnimating = false
    end
end)

------------------------------------------------------------
-- FPS / HUD
------------------------------------------------------------

local Frames = 0
local Elapsed = 0
local FPS = 60

RunService.RenderStepped:Connect(function(DT)

    Frames += 1
    Elapsed += DT

    if Elapsed >= 1 then

        FPS = Frames
        Frames = 0
        Elapsed = 0

    end

    if not Config.HUD.Enabled then
        return
    end

    local Lines = {}

    if Config.HUD.FPS then

        table.insert(
            Lines,
            "FPS: "..FPS
        )

    end

    if Config.HUD.Ping then

        local Ping = "?"

        pcall(function()

            Ping =
                math.floor(
                    Stats.Network.ServerStatsItem[
                        "Data Ping"
                    ]:GetValue()
                )

        end)

        table.insert(
            Lines,
            "Ping: "..Ping.."ms"
        )

    end

    if Config.HUD.Players then

        table.insert(
            Lines,
            "Players: "
            ..#Players:GetPlayers()
        )

    end

    if Config.HUD.XYZ then

        local Character =
            LocalPlayer.Character

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if Root then

            local Position =
                Root.Position

            table.insert(
                Lines,

                string.format(
                    "XYZ: %.0f, %.0f, %.0f",
                    Position.X,
                    Position.Y,
                    Position.Z
                )
            )
        end
    end

    HUDText.Text =
        table.concat(
            Lines,
            "\n"
        )
end)

