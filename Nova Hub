local ESPData = {}
local Skeletons = {}

local function IsTeammate(Player)
    return Config.Visual.TeamCheck and LocalPlayer.Team ~= nil and Player.Team == LocalPlayer.Team
end

local function RemoveESP(Player)
    local Data = ESPData[Player]
    if not Data then return end
    for _,Object in pairs(Data) do
        if typeof(Object) == "Instance" then
            Object:Destroy()
        end
    end
    ESPData[Player] = nil
end

local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "NovaESP"
ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.DisplayOrder = 80
ESPGui.Parent = PlayerGui

local R15Skeleton = {
    {"Head","UpperTorso"},
    {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},
    {"LeftUpperArm","LeftLowerArm"},
    {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},
    {"RightUpperArm","RightLowerArm"},
    {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},
    {"RightUpperLeg","RightLowerLeg"},
    {"RightLowerLeg","RightFoot"}
}

local R6Skeleton = {
    {"Head","Torso"},
    {"Torso","Left Arm"},
    {"Torso","Right Arm"},
    {"Torso","Left Leg"},
    {"Torso","Right Leg"}
}

local function CreateSkeletonLine(parent)
    local line = Instance.new("Frame")
    line.Name = "Bone"
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = Config.Visual.Color
    line.BorderSizePixel = 0
    line.Size = UDim2.fromOffset(0, Config.Visual.SkeletonThickness)
    line.Visible = false
    line.Parent = parent
    return line
end

local function CreateSkeleton(player)
    if player == LocalPlayer then return end
    if Skeletons[player] then
        Skeletons[player].Folder:Destroy()
        Skeletons[player] = nil
    end
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local folder = Instance.new("Folder")
    folder.Name = player.Name .. "_Skeleton"
    folder.Parent = ESPGui
    local connections
    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        connections = R15Skeleton
    else
        connections = R6Skeleton
    end
    local bones = {}
    for index, connection in ipairs(connections) do
        local part1 = character:FindFirstChild(connection[1])
        local part2 = character:FindFirstChild(connection[2])
        if part1 and part2 then
            local line = CreateSkeletonLine(folder)
            bones[index] = {
                Line = line,
                Part1 = part1,
                Part2 = part2,
            }
        end
    end
    Skeletons[player] = {
        Character = character,
        Folder = folder,
        Bones = bones,
    }
end

local function RemoveSkeleton(player)
    local data = Skeletons[player]
    if not data then return end
    if data.Folder then
        data.Folder:Destroy()
    end
    Skeletons[player] = nil
end

local function CreateESP(Player)
    if Player == LocalPlayer then return end
    RemoveESP(Player)
    RemoveSkeleton(Player)
    if not Config.Visual.ESP then return end
    if IsTeammate(Player) then return end
    local Character = Player.Character
    if not Character then return end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Head = Character:FindFirstChild("Head")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Root or not Head or not Humanoid then return end
    local Data = {}
    ESPData[Player] = Data
    if Config.Visual.Highlight or Config.Visual.Chams then
        local Highlight = Instance.new("Highlight")
        Highlight.Name = "NovaESPHighlight"
        Highlight.Adornee = Character
        Highlight.FillColor = Config.Visual.Color
        Highlight.OutlineColor = Config.Visual.Color
        Highlight.FillTransparency = Config.Visual.Chams and .55 or 1
        Highlight.OutlineTransparency = 0
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        Highlight.Parent = Character
        Data.Highlight = Highlight
    end
    if Config.Visual.Name or Config.Visual.Health or Config.Visual.Distance then
        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "NovaESPInfo"
        Billboard.Adornee = Head
        Billboard.Size = UDim2.fromOffset(180,70)
        Billboard.StudsOffset = Vector3.new(0,3,0)
        Billboard.AlwaysOnTop = true
        Billboard.Parent = Head
        local Text = Instance.new("TextLabel")
        Text.Size = UDim2.fromScale(1,1)
        Text.BackgroundTransparency = 1
        Text.TextColor3 = Config.Visual.Color
        Text.TextStrokeTransparency = .4
        Text.TextSize = Config.Visual.TextSize
        Text.Font = Enum.Font.GothamBold
        Text.Parent = Billboard
        Data.Billboard = Billboard
        Data.InfoText = Text
    end
    if Config.Visual.Box then
        local Box = Instance.new("Frame")
        Box.Name = "NovaBox"
        Box.AnchorPoint = Vector2.new(.5,.5)
        Box.BackgroundTransparency = 1
        Box.BorderSizePixel = 0
        Box.Visible = false
        Box.Parent = ESPGui
        local Stroke = Instance.new("UIStroke")
        Stroke.Color = Config.Visual.Color
        Stroke.Thickness = Config.Visual.BoxThickness
        Stroke.Parent = Box
        Data.Box = Box
        Data.BoxStroke = Stroke
    end
    if Config.Visual.Skeleton then
        CreateSkeleton(Player)
    end
    if Config.Visual.Tracer then
        local Tracer = Instance.new("Frame")
        Tracer.Name = "NovaTracer"
        Tracer.AnchorPoint = Vector2.new(.5,.5)
        Tracer.BorderSizePixel = 0
        Tracer.BackgroundColor3 = Config.Visual.Color
        Tracer.Size = UDim2.fromOffset(0, Config.Visual.TracerThickness)
        Tracer.Visible = false
        Tracer.Parent = ESPGui
        Data.Tracer = Tracer
    end
end

local function RefreshESP()
    for Player in pairs(ESPData) do
        RemoveESP(Player)
    end
    for Player in pairs(Skeletons) do
        RemoveSkeleton(Player)
    end
    if not Config.Visual.ESP then return end
    for _,Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            CreateESP(Player)
        end
    end
end

