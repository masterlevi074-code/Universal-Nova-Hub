------------------------------------------------------------

local function UpdateESP()

    if not Config.Visual.ESP then
        return
    end

    local Camera =
        workspace.CurrentCamera

    if not Camera then
        return
    end

    for Player,Data in pairs(ESPData) do

        local Character =
            Player.Character

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local Head =
            Character
            and Character:FindFirstChild(
                "Head"
            )

        if not Character
            or not Humanoid
            or not Root
            or not Head
            or Humanoid.Health <= 0 then

            if Data.Box then
                Data.Box.Visible = false
            end

            if Data.Tracer then
                Data.Tracer.Visible = false
            end

            if Data.InfoText then
                Data.InfoText.Visible = false
            end

            if Data.Skeleton then
                for _,Item in ipairs(Data.Skeleton) do
                    Item.Line.Visible = false
                end
            end

            continue
        end

        ----------------------------------------------------
        -- TEAM CHECK
        ----------------------------------------------------

        if IsTeammate(Player) then

            if Data.Box then
                Data.Box.Visible = false
            end

            if Data.Tracer then
                Data.Tracer.Visible = false
            end

            if Data.InfoText then
                Data.InfoText.Visible = false
            end

            continue
        end

        ----------------------------------------------------
        -- CHARACTER COLOR
        ----------------------------------------------------

        if Data.Highlight then

            Data.Highlight.FillColor =
                Config.Visual.Color

            Data.Highlight.OutlineColor =
                Config.Visual.Color

            Data.Highlight.FillTransparency =
                Config.Visual.Chams
                and .55
                or 1

            Data.Highlight.Enabled =
                Config.Visual.Highlight
                or Config.Visual.Chams
        end

        ----------------------------------------------------
        -- SCREEN POSITION
        ----------------------------------------------------

        local RootPosition,RootVisible =
            Camera:WorldToViewportPoint(
                Root.Position
            )

        local HeadPosition,HeadVisible =
            Camera:WorldToViewportPoint(
                Head.Position
            )

        if not RootVisible
            or not HeadVisible then

            if Data.Box then
                Data.Box.Visible = false
            end

            if Data.Tracer then
                Data.Tracer.Visible = false
            end

            if Data.InfoText then
                Data.InfoText.Visible = false
            end

            if Data.Skeleton then
                for _,Item in ipairs(Data.Skeleton) do
                    Item.Line.Visible = false
                end
            end

            continue
        end

        ----------------------------------------------------
        -- BOX
        ----------------------------------------------------

        if Data.Box then

            local Distance =
                (Camera.CFrame.Position
                -Root.Position).Magnitude

            local Height =
                math.clamp(
                    1800 / math.max(Distance,1),
                    25,
                    400
                )

            local Width =
                Height * .55

            Data.Box.Position =
                UDim2.fromOffset(
                    RootPosition.X,
                    RootPosition.Y
                )

            Data.Box.Size =
                UDim2.fromOffset(
                    Width,
                    Height
                )

            Data.Box.Visible =
                Config.Visual.Box

            if Data.BoxStroke then

                Data.BoxStroke.Color =
                    Config.Visual.Color

                Data.BoxStroke.Thickness = 1.5
            end
        end

        ----------------------------------------------------
        -- INFO
        ----------------------------------------------------

        if Data.InfoText then

            local Parts = {}

            if Config.Visual.Name then

                table.insert(
                    Parts,
                    Player.DisplayName
                )

            end

            if Config.Visual.Health then

                table.insert(
                    Parts,
                    "HP: "
                    ..math.floor(
                        Humanoid.Health
                    )
                    .."/"
                    ..math.floor(
                        Humanoid.MaxHealth
                    )
                )

            end

            if Config.Visual.Distance then

                local Distance =
                    (
                        Camera.CFrame.Position
                        -Root.Position
                    ).Magnitude

                table.insert(
                    Parts,
                    string.format(
                        "%.0fm",
                        Distance
                    )
                )
            end

            Data.InfoText.Text =
                table.concat(
                    Parts,
                    "  •  "
                )

            Data.InfoText.TextColor3 =
                Config.Visual.Color

            Data.InfoText.Visible =
                #Parts > 0
        end

        ----------------------------------------------------
        -- SKELETON
        ----------------------------------------------------

        if Data.Skeleton then

            for _,Item in ipairs(
                Data.Skeleton
            ) do

                local A =
                    Character:FindFirstChild(
                        Item.A
                    )

                local B =
                    Character:FindFirstChild(
                        Item.B
                    )

                if A and B then

                    local PositionA,VisibleA =
                        Camera:WorldToViewportPoint(
                            A.Position
                        )

                    local PositionB,VisibleB =
                        Camera:WorldToViewportPoint(
                            B.Position
                        )

                    if VisibleA and VisibleB then

                        Item.Line.BackgroundColor3 =
                            Config.Visual.Color

                        UpdateLine(
                            Item.Line,
                            Vector2.new(
                                PositionA.X,
                                PositionA.Y
                            ),
                            Vector2.new(
                                PositionB.X,
                                PositionB.Y
                            )
                        )

                    else

                        Item.Line.Visible = false

                    end

                else

                    Item.Line.Visible = false

                end
            end
        end

        ----------------------------------------------------
        -- TRACER
        ----------------------------------------------------

        if Data.Tracer then

            local Viewport =
                Camera.ViewportSize

            local Start =
                Vector2.new(
                    Viewport.X / 2,
                    Viewport.Y
                )

            local End =
                Vector2.new(
                    RootPosition.X,
                    RootPosition.Y
                )

            Data.Tracer.BackgroundColor3 =
                Config.Visual.Color

            UpdateLine(
                Data.Tracer,
                Start,
                End
            )

            Data.Tracer.Visible =
                Config.Visual.Tracer
        end
    end
end

