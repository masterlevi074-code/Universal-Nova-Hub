    Name.Parent = Row

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1,-65,0,13)
    Desc.Position = UDim2.fromOffset(12,24)
    Desc.BackgroundTransparency = 1
    Desc.Text = Description or ""
    Desc.TextColor3 = Color3.fromRGB(100,103,115)
    Desc.TextSize = 7
    Desc.Font = Enum.Font.GothamMedium
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.Parent = Row

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.fromOffset(40,22)
    Button.Position = UDim2.new(1,-50,.5,-11)
    Button.BackgroundColor3 = Color3.fromRGB(37,39,47)
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = Row

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(1,0)
    ButtonCorner.Parent = Button

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(16,16)
    Knob.Position = UDim2.fromOffset(3,3)
    Knob.BackgroundColor3 = Color3.fromRGB(155,158,168)
    Knob.Parent = Button

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1,0)
    KnobCorner.Parent = Knob

    local State = Initial

    local function Render()
        if not Button.Parent then return end
        if State then
            Button.BackgroundColor3 = Accent()
            Knob.Position = UDim2.new(1,-19,0,3)
            Knob.BackgroundColor3 = Color3.new(1,1,1)
        else
            Button.BackgroundColor3 = Color3.fromRGB(37,39,47)
            Knob.Position = UDim2.fromOffset(3,3)
            Knob.BackgroundColor3 = Color3.fromRGB(155,158,168)
        end
    end

    table.insert(ToggleRenderers,Render)

    local conn = Button.MouseButton1Click:Connect(function()
        PlayClickSound()
        State = not State
        Render()

        Tween(Button,{Size = UDim2.fromOffset(43,24)},TweenFast)
        task.delay(.07,function()
            if Button.Parent then
                Tween(Button,{Size = UDim2.fromOffset(40,22)},TweenFast)
            end
        end)

        if Callback then
            pcall(Callback, State)
        end
    end)
    AddConn(conn)

    Render()
    return Row
end

local function Slider(Parent, Title, Min, Max, Value, Callback, Format)
    local Row = Instance.new("Frame")
