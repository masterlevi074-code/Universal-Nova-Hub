local MinimizedButton -- reference to restore button when minimized

local function MinimizeHub()
    if MinimizedButton and MinimizedButton.Parent then
        -- já minimizado: restaurar
        MinimizedButton:Destroy()
        MinimizedButton = nil
        Main.Visible = true
        return
    end

    -- minimizar: esconder Main e criar botão de restauração
    Main.Visible = false

    local Btn = Instance.new("TextButton")
    Btn.Name = "NovaHubMinimized"
    Btn.Size = UDim2.fromOffset(100,30)
    Btn.Position = UDim2.new(0,10,0,10)
    Btn.BackgroundColor3 = DarkColor()
    Btn.TextColor3 = Color3.new(1,1,1)
    Btn.Text = "Nova Hub"
    Btn.Font = Enum.Font.GothamBold
    Btn.Parent = Gui

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0,8)
    BtnCorner.Parent = Btn

    MinimizedButton = Btn

    local conn = Btn.MouseButton1Click:Connect(function()
        PlayClickSound()
        if MinimizedButton then
            MinimizedButton:Destroy()
            MinimizedButton = nil
        end
        Main.Visible = true
    end)
    AddConn(conn)
end

Minimize.MouseButton1Click:Connect(function()
    PlayClickSound()
    MinimizeHub()
end)

