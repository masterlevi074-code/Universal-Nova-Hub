    local Number =
        Instance.new("TextLabel")

    Number.Size =
        UDim2.fromOffset(48,18)

    Number.Position =
        UDim2.new(1,-58,0,4)

    Number.BackgroundTransparency = 1

    Number.TextColor3 =
        Color3.fromRGB(150,153,164)

    Number.TextSize = 8

    Number.Font =
        Enum.Font.GothamBold

    Number.TextXAlignment =
        Enum.TextXAlignment.Right

    Number.Parent = Row

    local Bar =
        Instance.new("TextButton")

    Bar.Size =
        UDim2.new(1,-20,0,5)

    Bar.Position =
        UDim2.fromOffset(10,37)

    Bar.BackgroundColor3 =
        Color3.fromRGB(38,40,48)

    Bar.Text = ""
    Bar.AutoButtonColor = false
    Bar.Parent = Row

    Instance.new("UICorner",Bar).CornerRadius =
        UDim.new(1,0)

    local Fill =
        Instance.new("Frame")

    Fill.BackgroundColor3 =
        Accent()

    Fill.BorderSizePixel = 0
    Fill.Parent = Bar

    Instance.new("UICorner",Fill).CornerRadius =
        UDim.new(1,0)

    local function UpdateAccent()

        if Fill.Parent then
            Fill.BackgroundColor3 =
                Accent()
        end
    end

    table.insert(
        ToggleRenderers,
        UpdateAccent
    )

    local Dragging = false

    local function Set(Input)

        local Percent =
            math.clamp(
                (
                    Input.Position.X
                    -Bar.AbsolutePosition.X
                )
                /Bar.AbsoluteSize.X,
                0,
                1
            )

        local NewValue =
            Min
            +(Max-Min)*Percent

        Fill.Size =
            UDim2.fromScale(
                Percent,
                1
            )

        if Format then

            Number.Text =
                Format(NewValue)

        else

            Number.Text =
                string.format(
                    "%.2f",
                    NewValue
                )

        end

        if Callback then
            Callback(NewValue)
        end
    end

    Bar.InputBegan:Connect(function(Input)

        if Input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or Input.UserInputType ==
            Enum.UserInputType.Touch then

            Dragging = true

            Set(Input)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)

        if not Dragging then
            return
        end

        if Input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or Input.UserInputType ==
            Enum.UserInputType.Touch then

            Set(Input)
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)

        if Input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or Input.UserInputType ==
            Enum.UserInputType.Touch then

            Dragging = false
        end
    end)

    local Percent =
        math.clamp(
            (Value-Min)/(Max-Min),
            0,
            1
        )

    Fill.Size =
        UDim2.fromScale(
            Percent,
            1
        )

    if Format then

        Number.Text =
            Format(Value)

    else

        Number.Text =
            string.format(
                "%.2f",
                Value
            )

    end

    return Row
end

