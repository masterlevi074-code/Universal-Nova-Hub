local function MakeTab(Text,Y)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.fromOffset(45,40)
    Button.Position = UDim2.fromOffset(10,Y)
    Button.BackgroundColor3 = Color3.fromRGB(18,19,24)
    Button.Text = Text
    Button.TextColor3 = Color3.fromRGB(130,133,143)
    Button.TextSize = 18
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.Parent = Sidebar

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0,10)
    Corner.Parent = Button

    Button.MouseEnter:Connect(function()
        if ActiveTab ~= Button then
            Tween(Button,{
                BackgroundColor3 = Color3.fromRGB(28,30,38),
                TextColor3 = Color3.new(1,1,1)
            })
        end
    end)

    Button.MouseLeave:Connect(function()
        if ActiveTab ~= Button then
            Tween(Button,{
                BackgroundColor3 = Color3.fromRGB(18,19,24),
                TextColor3 = Color3.fromRGB(130,133,143)
            })
        end
    end)

    return Button
end

