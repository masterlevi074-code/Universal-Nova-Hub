local function UpdateTargetHighlight(Target)
    if not Config.Aim.TargetHighlight or not Target then
        TargetHighlight.Enabled = false
        return
    end
    local Character = Target.Parent
    if not Character then
        TargetHighlight.Enabled = false
        return
    end
    TargetHighlight.Adornee = Character
    TargetHighlight.FillColor = Config.Aim.Color
    TargetHighlight.OutlineColor = Config.Aim.Color
    TargetHighlight.Enabled = true
end

RunService:BindToRenderStep("NovaAim", Enum.RenderPriority.Camera.Value+1, function()
    if not Config.Aim.Enabled then
        CurrentTarget = nil
        UpdateTargetHighlight(nil)
        return
    end
    if not Camera then
        Camera = workspace.CurrentCamera
        if not Camera then return end
    end
    local Target = GetTarget()
    CurrentTarget = Target
    UpdateTargetHighlight(Target)
    if not Target or not Target.Parent then return end
    local Position = Target.Position
    if Config.Aim.Prediction then
        local Root = Target.Parent:FindFirstChild("HumanoidRootPart")
        if Root and Root.AssemblyLinearVelocity then
            Position += Root.AssemblyLinearVelocity * Config.Aim.PredictionStrength
        end
    end
    local Desired = CFrame.lookAt(Camera.CFrame.Position, Position)
    Camera.CFrame = Camera.CFrame:Lerp(Desired, Config.Aim.Smoothness)
end)

-- ESP RENDER
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    if not Camera then return end

    for player, data in pairs(Skeletons) do
        if not player.Parent then
            RemoveSkeleton(player)
            continue
        end
        local character = data.Character
        if not character or not character.Parent then
            RemoveSkeleton(player)
            continue
        end
        if not Config.Visual.ESP or not Config.Visual.Skeleton then
            for _, bone in pairs(data.Bones) do
                bone.Line.Visible = false
            end
            continue
        end
        if IsTeammate(player) then
            for _, bone in pairs(data.Bones) do
                bone.Line.Visible = false
            end
            continue
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            for _, bone in pairs(data.Bones) do
                bone.Line.Visible = false
            end
            continue
        end
        local localCharacter = LocalPlayer.Character
        if not localCharacter then continue end
        local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        if not localRoot or not targetRoot then continue end
        local distance = (targetRoot.Position - localRoot.Position).Magnitude
        if distance > Config.Visual.MaxDistance then
            for _, bone in pairs(data.Bones) do
                bone.Line.Visible = false
            end
            continue
        end
        for _, bone in pairs(data.Bones) do
            local part1 = bone.Part1
            local part2 = bone.Part2
            local line = bone.Line
            if not part1 or not part2 or not part1.Parent or not part2.Parent then
                line.Visible = false
                continue
            end
            local position1, visible1 = Camera:WorldToViewportPoint(part1.Position)
            local position2, visible2 = Camera:WorldToViewportPoint(part2.Position)
            if not visible1 and not visible2 then
                line.Visible = false
                continue
            end
            local delta = Vector2.new(position2.X, position2.Y) - Vector2.new(position1.X, position1.Y)
            local length = delta.Magnitude
            if length <= 0 or length > 500 then
                line.Visible = false
                continue
            end
            local middle = (Vector2.new(position1.X, position1.Y) + Vector2.new(position2.X, position2.Y)) / 2
            line.Position = UDim2.fromOffset(middle.X, middle.Y)
            line.Size = UDim2.fromOffset(length, Config.Visual.SkeletonThickness)
            line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            line.BackgroundColor3 = Config.Visual.Color
            line.Visible = true
        end
    end

    for Player,Data in pairs(ESPData) do
        local Character = Player.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        local Head = Character and Character:FindFirstChild("Head")
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not Character or not Root or not Head or not Humanoid or Humanoid.Health <= 0 then
            if Data.Box then Data.Box.Visible = false end
            if Data.Tracer then Data.Tracer.Visible = false end
            continue
        end
        local MyCharacter = LocalPlayer.Character
        local MyRoot = MyCharacter and MyCharacter:FindFirstChild("HumanoidRootPart")
        local Distance = math.huge
        if MyRoot then
            Distance = (Root.Position-MyRoot.Position).Magnitude
        end
        if Distance > Config.Visual.MaxDistance then
            if Data.Box then Data.Box.Visible = false end
            if Data.Tracer then Data.Tracer.Visible = false end
            continue
        end
        if Data.InfoText then
            local Lines = {}
            if Config.Visual.Name then table.insert(Lines, Player.DisplayName) end
            if Config.Visual.Health then table.insert(Lines, "HP: "..math.floor(Humanoid.Health)) end
            if Config.Visual.Distance then table.insert(Lines, "Distance: "..math.floor(Distance)) end
            Data.InfoText.Text = table.concat(Lines, "\n")
            Data.InfoText.TextColor3 = Config.Visual.Color
            Data.Billboard.Enabled = #Lines > 0
        end
        if Data.Highlight then
            Data.Highlight.FillColor = Config.Visual.Color
            Data.Highlight.OutlineColor = Config.Visual.Color
            Data.Highlight.FillTransparency = Config.Visual.Chams and .55 or 1
        end
        if Data.Box then
            local TopPoint = Camera:WorldToViewportPoint(Head.Position + Vector3.new(0,.5,0))
            local BottomPoint = Camera:WorldToViewportPoint(Root.Position - Vector3.new(0,3,0))
            if TopPoint.Z > 0 and BottomPoint.Z > 0 then
                local Height = math.abs(BottomPoint.Y - TopPoint.Y)
                local Width = Height*.55
                if Height < 500 and Width < 500 then
                    Data.Box.Position = UDim2.fromOffset((TopPoint.X+BottomPoint.X)/2, (TopPoint.Y+BottomPoint.Y)/2)
                    Data.Box.Size = UDim2.fromOffset(Width, Height)
                    Data.BoxStroke.Color = Config.Visual.Color
                    Data.BoxStroke.Thickness = Config.Visual.BoxThickness
                    Data.Box.Visible = true
                else
                    Data.Box.Visible = false
                end
            else
                Data.Box.Visible = false
            end
        end
        if Data.Tracer then
            local Point,IsVisible = Camera:WorldToViewportPoint(Root.Position)
            if IsVisible and Point.Z > 0 then
                local Start = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                local End = Vector2.new(Point.X, Point.Y)
                local TracerDistance = (End - Start).Magnitude
                if TracerDistance < 1000 then
                    Data.Tracer.BackgroundColor3 = Config.Visual.Color
                    local Delta = End - Start
                    Data.Tracer.Position = UDim2.fromOffset((Start.X+End.X)/2, (Start.Y+End.Y)/2)
                    Data.Tracer.Size = UDim2.fromOffset(Delta.Magnitude, Config.Visual.TracerThickness)
                    Data.Tracer.Rotation = math.deg(math.atan2(Delta.Y, Delta.X))
                    Data.Tracer.Visible = true
                else
                    Data.Tracer.Visible = false
                end
            else
                Data.Tracer.Visible = false
            end
        end
    end
end)

