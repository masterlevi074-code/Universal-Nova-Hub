local LastTick =
    tick()

local Frames =
    0

local FPS =
    0

RunService.RenderStepped:Connect(function()

    Frames += 1

    local Now =
        tick()

    if Now - LastTick >= 1 then

        FPS =
            Frames

        Frames = 0

        LastTick =
            Now

    end
end)

local function GetPing()

    local Ping = 0

    pcall(function()

        local Network =
            Stats.Network

        local ServerStats =
            Network.ServerStatsItem

        local PingItem =
            ServerStats[
                "Data Ping"
            ]

        if PingItem then

            Ping =
                PingItem:GetValue()

        end
    end)

    return math.floor(Ping)
end

local function UpdateHUD()

    if not HUDFrame.Parent then
        return
    end

    HUDFrame.Visible =
        Config.HUD.Enabled

    local Info = {}

    if Config.HUD.FPS then

        table.insert(
            Info,
            "FPS: "..tostring(FPS)
        )

    end

    if Config.HUD.Ping then

        table.insert(
            Info,
            "PING: "..tostring(
                GetPing()
            ).."ms"
        )

    end

    if Config.HUD.Players then

        table.insert(
            Info,
            "PLAYERS: "..tostring(
                #Players:GetPlayers()
            )
        )

    end

    if Config.HUD.XYZ then

        local Character =
            LocalPlayer.Character

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if Root then

            local P =
                Root.Position

            table.insert(
                Info,
                string.format(
                    "XYZ: %.0f %.0f %.0f",
                    P.X,
                    P.Y,
                    P.Z
                )
            )

        end
    end

    HUDInfo.Text =
        table.concat(
            Info,
            "   •   "
        )

    HUDStroke.Color =
        Accent()

    ApplyHUDTransparency()
    ApplyHUDSize()
    ApplyHUDPosition()
end

