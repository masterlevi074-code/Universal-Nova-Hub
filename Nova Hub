    Label.TextSize = 9
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.fromOffset(110,30)
    Button.Position = UDim2.new(1,-120,.5,-15)
    Button.BackgroundColor3 = Color3.fromRGB(32,34,42)
    Button.Text = tostring(Current) .. " ▼"
    Button.TextColor3 = Color3.fromRGB(180,183,194)
    Button.TextSize = 8
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.Parent = Row

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0,7)
    ButtonCorner.Parent = Button

    Button.MouseEnter:Connect(function()
        PlayHoverSound()
        Tween(Button,{BackgroundColor3 = HoverColor()})
    end)
    Button.MouseLeave:Connect(function()
        Tween(Button,{BackgroundColor3 = Color3.fromRGB(32,34,42)})
    end)

    local conn = Button.MouseButton1Click:Connect(function()
        PlayClickSound()
        ClosePopup()

        local Popup = Instance.new("Frame")
        Popup.Size = UDim2.fromOffset(110, #Options*30 + 10)
        Popup.BackgroundColor3 = Color3.fromRGB(28,30,38)
        Popup.BorderSizePixel = 0
        Popup.ZIndex = 1000
        Popup.Parent = PopupLayer

        ActivePopup = Popup

        local PopupCorner = Instance.new("UICorner")
        PopupCorner.CornerRadius = UDim.new(0,8)
        PopupCorner.Parent = Popup

        -- set position after one frame to ensure AbsolutePosition available
        task.spawn(function()
            task.wait()
            if not Popup.Parent or not Row.Parent then return end
            local x = Row.AbsolutePosition.X + Row.AbsoluteSize.X - 120
            local y = Row.AbsolutePosition.Y + Row.AbsoluteSize.Y + 3
            Popup.Position = UDim2.fromOffset(x, y)
        end)

        for Index,Option in ipairs(Options) do
            local OptionButton = Instance.new("TextButton")
            OptionButton.Size = UDim2.new(1,-10,0,26)
            OptionButton.Position = UDim2.fromOffset(5,5+(Index-1)*30)
            OptionButton.BackgroundColor3 = Color3.fromRGB(28,30,38)
            OptionButton.Text = Option
            OptionButton.TextColor3 = Color3.fromRGB(200,202,210)
            OptionButton.TextSize = 8
            OptionButton.Font = Enum.Font.GothamMedium
            OptionButton.AutoButtonColor = false
            OptionButton.ZIndex = 1001
            OptionButton.Parent = Popup

            local OptionCorner = Instance.new("UICorner")
            OptionCorner.CornerRadius = UDim.new(0,5)
            OptionCorner.Parent = OptionButton

            if tostring(Option) == tostring(Current) then
                OptionButton.BackgroundColor3 = Accent()
                OptionButton.TextColor3 = Color3.new(1,1,1)
            end

            OptionButton.MouseEnter:Connect(function()
                PlayHoverSound()
                if tostring(Option) ~= tostring(Current) then
                    Tween(OptionButton,{BackgroundColor3 = HoverColor()})
                end
            end)

            OptionButton.MouseLeave:Connect(function()
                if tostring(Option) ~= tostring(Current) then
                    Tween(OptionButton,{BackgroundColor3 = Color3.fromRGB(28,30,38)})
                end
            end)

            OptionButton.MouseButton1Click:Connect(function()
                PlayClickSound()
                Button.Text = tostring(Option) .. " ▼"
                if Callback then pcall(Callback, Option) end
                ClosePopup()
            end)
        end
    end)
    AddConn(conn)

    return Row
end

