local ESPData = {}

local function IsTeammate(Player)
    return Config.Visual.TeamCheck and LocalPlayer.Team ~= nil and Player.Team == LocalPlayer.Team
end

local function RemoveESP(Player)
    local Data = ESPData[Player]
    if not Data then return end

    for _,Object in pairs(Data) do
        if typeof(Object) == "Instance" then
            Object:Destroy()
        end
    end

    ESPData[Player] = nil
end

local function CleanupSkeleton(Player)
    local Data = ESPData[Player]
    if not Data or not Data.Skeleton then return end

    for _,Bone in pairs(Data.Skeleton) do
        if Bone.Line then
            Bone.Line.Visible = false
        end
    end
end

local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "NovaESP"
ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.DisplayOrder = 80
ESPGui.Parent = PlayerGui

local function CreateLine(Parent)
    local Line = Instance.new("Frame")
    Line.AnchorPoint = Vector2.new(.5,.5)
    Line.BorderSizePixel = 0
    Line.BackgroundColor3 = Config.Visual.Color
    Line.Visible = false
    Line.Parent = Parent
    return Line
end

local function UpdateLine(Line,A,B)
    if not Line then return end
    if not A or not B then
        Line.Visible = false
        return
    end

    if typeof(A) ~= "Vector2" or typeof(B) ~= "Vector2" then
        Line.Visible = false
        return
    end

    if A.X ~= A.X or A.Y ~= A.Y or B.X ~= B.X or B.Y ~= B.Y then
        Line.Visible = false
        return
    end

    local ScreenSize = Camera.ViewportSize

    if A.X < -500 or A.X > ScreenSize.X + 500
        or A.Y < -500 or A.Y > ScreenSize.Y + 500
        or B.X < -500 or B.X > ScreenSize.X + 500
        or B.Y < -500 or B.Y > ScreenSize.Y + 500 then

        Line.Visible = false
        return
    end

    local Delta = B - A

    if Delta.Magnitude > 300 then
        Line.Visible = false
        return
    end

    Line.Position = UDim2.fromOffset((A.X + B.X) / 2, (A.Y + B.Y) / 2)
    Line.Size = UDim2.fromOffset(Delta.Magnitude, 2)
    Line.Rotation = math.deg(math.atan2(Delta.Y, Delta.X))
    Line.Visible = true
end

