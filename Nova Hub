local function CreateESP(Player)

    if Player == LocalPlayer then
        return
    end

    RemoveESP(Player)

    if not Config.Visual.ESP then
        return
    end

    if IsTeammate(Player) then
        return
    end

    local Character =
        Player.Character

    if not Character then
        return
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Head =
        Character:FindFirstChild(
            "Head"
        )

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Root
        or not Head
        or not Humanoid then

        return
    end

    local Data = {}

    ESPData[Player] =
        Data

    --------------------------------------------------------
    -- HIGHLIGHT
    --------------------------------------------------------

    if Config.Visual.Highlight
        or Config.Visual.Chams then

        local Highlight =
            Instance.new("Highlight")

        Highlight.Name =
            "NovaESPHighlight"

        Highlight.Adornee =
            Character

        Highlight.FillColor =
            Config.Visual.Color

        Highlight.OutlineColor =
            Config.Visual.Color

        Highlight.FillTransparency =
            Config.Visual.Chams
            and .55
            or 1

        Highlight.OutlineTransparency = 0

        Highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        Highlight.Parent =
            Character

        Data.Highlight =
            Highlight
    end

    --------------------------------------------------------
    -- INFO
    --------------------------------------------------------

    if Config.Visual.Name
        or Config.Visual.Health
        or Config.Visual.Distance then

        local Billboard =
            Instance.new("BillboardGui")

        Billboard.Name =
            "NovaESPInfo"

        Billboard.Adornee =
            Head

        Billboard.Size =
            UDim2.fromOffset(
                180,
                70
            )

        Billboard.StudsOffset =
            Vector3.new(0,3,0)

        Billboard.AlwaysOnTop = true
        Billboard.Parent =
            Head

        local Text =
            Instance.new("TextLabel")

        Text.Size =
            UDim2.fromScale(1,1)

        Text.BackgroundTransparency = 1

        Text.TextColor3 =
            Config.Visual.Color

        Text.TextStrokeTransparency = .4

        Text.TextSize = 11

        Text.Font =
            Enum.Font.GothamBold

        Text.Parent =
            Billboard

        Data.Billboard =
            Billboard

        Data.InfoText =
            Text
    end

    --------------------------------------------------------
    -- BOX
    --------------------------------------------------------

    if Config.Visual.Box then

        local Box =
            Instance.new("Frame")

        Box.Name =
            "NovaBox"

        Box.AnchorPoint =
            Vector2.new(.5,.5)

        Box.BackgroundTransparency = 1
        Box.BorderSizePixel = 0
        Box.Visible = false
        Box.Parent = ESPGui

        local Stroke =
            Instance.new("UIStroke")

        Stroke.Color =
            Config.Visual.Color

        Stroke.Thickness = 1.5
        Stroke.Parent = Box

        Data.Box =
            Box

        Data.BoxStroke =
            Stroke
    end

    --------------------------------------------------------
    -- SKELETON
    --------------------------------------------------------

    if Config.Visual.Skeleton then

        local Skeleton = {}

        local Connections

        if Character:FindFirstChild(
            "UpperTorso"
        ) then

            Connections =
                R15Skeleton

        else

            Connections =
                R6Skeleton

        end

        for Index,Connection in ipairs(
            Connections
        ) do

            local Line =
                CreateLine(ESPGui)

            Line.Name =
                "NovaSkeleton_"..Index

            Skeleton[Index] = {

                Line = Line,

                A = Connection[1],

                B = Connection[2]
            }
        end

        Data.Skeleton =
            Skeleton
    end

    --------------------------------------------------------
    -- TRACER
    --------------------------------------------------------

    if Config.Visual.Tracer then

        local Tracer =
            CreateLine(ESPGui)

        Tracer.Name =
            "NovaTracer"

        Data.Tracer =
            Tracer
    end
end

