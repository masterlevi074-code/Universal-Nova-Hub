    local bcorner = Instance.new("UICorner"); bcorner.CornerRadius = UDim.new(1,0); bcorner.Parent = Bar

    local Fill = Instance.new("Frame")
    Fill.BackgroundColor3 = Accent()
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar
    local fcorner = Instance.new("UICorner"); fcorner.CornerRadius = UDim.new(1,0); fcorner.Parent = Fill

    local function UpdateAccent() if Fill.Parent then Fill.BackgroundColor3 = Accent() end end
    table.insert(ToggleRenderers, UpdateAccent)

    local Dragging = false

    local function Set(Input)
        local Percent = math.clamp((Input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local NewValue = Min + (Max - Min) * Percent
        Fill.Size = UDim2.fromScale(Percent,1)
        if Format then Number.Text = Format(NewValue) else Number.Text = string.format("%.2f", NewValue) end
        if Callback then Callback(NewValue) end
    end

    Bar.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            Set(Input)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            Set(Input)
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    local Percent = math.clamp((Value-Min)/(Max-Min), 0, 1)
    Fill.Size = UDim2.fromScale(Percent,1)
    if Format then Number.Text = Format(Value) else Number.Text = string.format("%.2f",Value) end

    return Row
end

