-- TARGET (AIM ASSIST FUNCIONANDO)
------------------------------------------------------------

local function IsValidTarget(Player)
    if Player == LocalPlayer then return false end
    if Config.Aim.TeamCheck and LocalPlayer.Team and Player.Team == LocalPlayer.Team then return false end
    local Character = Player.Character
    if not Character then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or Humanoid.Health <= 0 or not Root then return false end
    return true
end

local function Visible(Part)
    if not Config.Aim.WallCheck then return true end
    local Origin = Camera.CFrame.Position
    local Direction = Part.Position-Origin
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {LocalPlayer.Character}
    Params.IgnoreWater = true
    local Result = workspace:Raycast(Origin, Direction, Params)
    if not Result then return true end
    return Result.Instance:IsDescendantOf(Part.Parent)
end

local CurrentTarget

local function GetTarget()
    local Center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local BestPart
    local BestScore = math.huge
    for _,Player in ipairs(Players:GetPlayers()) do
        if IsValidTarget(Player) then
            local Character = Player.Character
            local Part = Character:FindFirstChild(Config.Aim.TargetPart)
            if Part and Visible(Part) then
                local Screen,OnScreen = Camera:WorldToViewportPoint(Part.Position)
                if OnScreen then
                    local CrosshairDistance = (Vector2.new(Screen.X, Screen.Y)-Center).Magnitude
                    if CrosshairDistance <= Config.Aim.FOV then
                        local Score = CrosshairDistance
                        if Config.Aim.TargetPriority and Config.Aim.PriorityMode == "Distance" then
                            local MyCharacter = LocalPlayer.Character
                            local MyRoot = MyCharacter and MyCharacter:FindFirstChild("HumanoidRootPart")
                            local Root = Character:FindFirstChild("HumanoidRootPart")
                            if MyRoot and Root then
                                Score = (Root.Position-MyRoot.Position).Magnitude
                            end
                        end
                        if Score < BestScore then
                            BestScore = Score
                            BestPart = Part
                        end
                    end
                end
            end
        end
    end
    return BestPart
end

local TargetHighlight = Instance.new("Highlight")
TargetHighlight.Name = "NovaTargetHighlight"
TargetHighlight.FillColor = Config.Aim.Color
TargetHighlight.OutlineColor = Config.Aim.Color
TargetHighlight.FillTransparency = .75
TargetHighlight.OutlineTransparency = 0
TargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
TargetHighlight.Enabled = false
TargetHighlight.Parent = Gui

local function UpdateTargetHighlight(Target)
    if not Config.Aim.TargetHighlight or not Target then
        TargetHighlight.Enabled = false
        return
    end
    local Character = Target.Parent
    if not Character then
        TargetHighlight.Enabled = false
        return
    end
    TargetHighlight.Adornee = Character
    TargetHighlight.FillColor = Config.Aim.Color
    TargetHighlight.OutlineColor = Config.Aim.Color
    TargetHighlight.Enabled = true
end

RunService:BindToRenderStep("NovaAim", Enum.RenderPriority.Camera.Value+1, function()
    local Target
    if Config.Aim.Enabled then
        Target = GetTarget()
    end
    CurrentTarget = Target
    UpdateTargetHighlight(Target)
    if not Target then return end
    local Position = Target.Position
    if Config.Aim.Prediction then
        local Root = Target.Parent:FindFirstChild("HumanoidRootPart")
        if Root then
            Position += Root.AssemblyLinearVelocity * Config.Aim.PredictionStrength
        end
    end
    local Desired = CFrame.lookAt(Camera.CFrame.Position, Position)
    Camera.CFrame = Camera.CFrame:Lerp(Desired, Config.Aim.Smoothness)
end)

