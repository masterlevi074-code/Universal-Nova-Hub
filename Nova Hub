        Enum.Font.GothamMedium

    Name.TextXAlignment =
        Enum.TextXAlignment.Left

    Name.Parent = Row

    local Desc =
        Instance.new("TextLabel")

    Desc.Size =
        UDim2.new(1,-65,0,13)

    Desc.Position =
        UDim2.fromOffset(10,22)

    Desc.BackgroundTransparency = 1

    Desc.Text = Description

    Desc.TextColor3 =
        Color3.fromRGB(84,87,98)

    Desc.TextSize = 7

    Desc.Font =
        Enum.Font.GothamMedium

    Desc.TextXAlignment =
        Enum.TextXAlignment.Left

    Desc.Parent = Row

    local Button =
        Instance.new("TextButton")

    Button.Size =
        UDim2.fromOffset(38,21)

    Button.Position =
        UDim2.new(1,-48,.5,-10)

    Button.BackgroundColor3 =
        Color3.fromRGB(37,39,47)

    Button.Text = ""
    Button.AutoButtonColor = false
    Button.Parent = Row

    Instance.new("UICorner",Button).CornerRadius =
        UDim.new(1,0)

    local Knob =
        Instance.new("Frame")

    Knob.Size =
        UDim2.fromOffset(15,15)

    Knob.Position =
        UDim2.fromOffset(3,3)

    Knob.BackgroundColor3 =
        Color3.fromRGB(155,158,168)

    Knob.Parent = Button

    Instance.new("UICorner",Knob).CornerRadius =
        UDim.new(1,0)

    local State = Initial

    local function Render()

        if not Button.Parent then
            return
        end

        if State then

            Button.BackgroundColor3 =
                Accent()

            Knob.Position =
                UDim2.new(1,-18,0,3)

            Knob.BackgroundColor3 =
                Color3.new(1,1,1)

        else

            Button.BackgroundColor3 =
                Color3.fromRGB(37,39,47)

            Knob.Position =
                UDim2.fromOffset(3,3)

            Knob.BackgroundColor3 =
                Color3.fromRGB(155,158,168)

        end
    end

    table.insert(
        ToggleRenderers,
        Render
    )

    Button.MouseButton1Click:Connect(function()

        State = not State

        Render()

        Tween(
            Button,
            {
                Size =
                    UDim2.fromOffset(41,23)
            },
            TweenFast
        )

        task.delay(.07,function()

            if Button.Parent then

                Tween(
                    Button,
                    {
                        Size =
                            UDim2.fromOffset(38,21)
                    },
                    TweenFast
                )

            end
        end)

        if Callback then
            Callback(State)
        end
    end)

    Render()

    return Row
end

