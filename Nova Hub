------------------------------------------------------------
-- HUD UPDATE (appearance: size/alpha/text size)
------------------------------------------------------------

local function UpdateHUDAppearance()

    local oldSize = prevHUDSize or Config.HUD.Size
    local newSize = math.floor(Config.HUD.Size or oldSize)
    local delta = newSize - oldSize

    -- adjust size
    HUDFrame.Size =
        UDim2.fromOffset(
            newSize,
            50
        )

    -- shift position half the delta so it expands from the center horizontally
    local pos = HUDFrame.Position
    HUDFrame.Position = UDim2.new(
        pos.X.Scale,
        pos.X.Offset - math.floor(delta/2),
        pos.Y.Scale,
        pos.Y.Offset
    )

    -- background/transparency
    HUDFrame.BackgroundTransparency =
        Config.HUD.Transparency

    HUDStroke.Transparency =
        Config.HUD.Transparency

    -- text transparency should follow HUD transparency (so numbers/letters fade)
    HUDText.TextTransparency =
        Config.HUD.Transparency

    -- scale text size with HUD size
    local textSize = math.clamp(math.floor(newSize/13), 7, 32)
    HUDText.TextSize = textSize

    prevHUDSize = newSize
end

