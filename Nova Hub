local clickConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if ActivePopup then
            -- if click is outside ActivePopup, close it
            local mousePos = UserInputService:GetMouseLocation()
            local ap = ActivePopup.AbsolutePosition
            local asz = ActivePopup.AbsoluteSize
            if not (mousePos.X >= ap.X and mousePos.X <= ap.X + asz.X and mousePos.Y >= ap.Y and mousePos.Y <= ap.Y + asz.Y) then
                ClosePopup()
            end
        end
    end
end)
AddConn(clickConn)

