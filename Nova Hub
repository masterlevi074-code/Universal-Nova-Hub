local HUDDragging = false
local HUDDragStart
local HUDStartPosition

HUDFrame.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1
        or Input.UserInputType ==
        Enum.UserInputType.Touch then

        HUDDragging = true
