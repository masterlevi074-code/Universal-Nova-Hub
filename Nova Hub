------------------------------------------------------------

RunService.RenderStepped:Connect(function()

    for Player,Data in pairs(ESPData) do

        local Character =
            Player.Character

        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local Head =
            Character
            and Character:FindFirstChild(
                "Head"
            )

        local Humanoid =
            Character
            and Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not Character
            or not Root
            or not Head
            or not Humanoid
            or Humanoid.Health <= 0 then

            if Data.Box then
                Data.Box.Visible = false
            end

            if Data.Tracer then
                Data.Tracer.Visible = false
            end

            if Data.Skeleton then

                for _,Bone in pairs(
                    Data.Skeleton
                ) do

                    Bone.Line.Visible = false

                end
            end

            continue
        end

        ----------------------------------------------------
        -- DISTANCE
        ----------------------------------------------------

        local MyCharacter =
            LocalPlayer.Character

        local MyRoot =
            MyCharacter
            and MyCharacter:FindFirstChild(
                "HumanoidRootPart"
            )

        local Distance = math.huge

        if MyRoot then

            Distance =
                (
                    Root.Position
                    -MyRoot.Position
                ).Magnitude

        end

        if Distance >
            Config.Visual.MaxDistance then

            if Data.Box then
                Data.Box.Visible = false
            end

            if Data.Tracer then
                Data.Tracer.Visible = false
            end

            if Data.Skeleton then

                for _,Bone in pairs(
                    Data.Skeleton
                ) do

                    Bone.Line.Visible = false

                end
            end

            continue
        end

        ----------------------------------------------------
        -- INFO
        ----------------------------------------------------

        if Data.InfoText then

            local Lines = {}

            if Config.Visual.Name then

                table.insert(
                    Lines,
                    Player.DisplayName
                )

            end

            if Config.Visual.Health then

                table.insert(
                    Lines,
                    "HP: "
                    ..math.floor(
                        Humanoid.Health
                    )
                )

            end

            if Config.Visual.Distance then

                table.insert(
                    Lines,
                    "Distance: "
                    ..math.floor(Distance)
                )

            end

            Data.InfoText.Text =
                table.concat(
                    Lines,
                    "\n"
                )

            Data.InfoText.TextColor3 =
                Config.Visual.Color

            Data.Billboard.Enabled =
                #Lines > 0
        end

        ----------------------------------------------------
        -- HIGHLIGHT
        ----------------------------------------------------

        if Data.Highlight then

            Data.Highlight.FillColor =
                Config.Visual.Color

            Data.Highlight.OutlineColor =
                Config.Visual.Color

            Data.Highlight.FillTransparency =
                Config.Visual.Chams
                and .55
                or 1
        end

        ----------------------------------------------------
        -- BOX
        ----------------------------------------------------

        if Data.Box then

            local TopPoint =
                Camera:WorldToViewportPoint(
                    Head.Position
                    +Vector3.new(0,.5,0)
                )

            local BottomPoint =
                Camera:WorldToViewportPoint(
                    Root.Position
                    -Vector3.new(0,3,0)
                )

            if TopPoint.Z > 0
                and BottomPoint.Z > 0 then

                local Height =
                    math.abs(
                        BottomPoint.Y
                        -TopPoint.Y
                    )

                local Width =
                    Height*.55

                Data.Box.Position =
                    UDim2.fromOffset(
                        (TopPoint.X+BottomPoint.X)/2,
                        (TopPoint.Y+BottomPoint.Y)/2
                    )

                Data.Box.Size =
                    UDim2.fromOffset(
                        Width,
                        Height
                    )

                Data.BoxStroke.Color =
                    Config.Visual.Color

                Data.Box.Visible = true

            else

                Data.Box.Visible = false

            end
        end

        ----------------------------------------------------
        -- SKELETON
        ----------------------------------------------------

        if Data.Skeleton then

            local Parts =
                GetCharacterParts(
                    Character
                )

            for _,Bone in pairs(
                Data.Skeleton
            ) do

                local A =
                    Parts[Bone.A]

                local B =
                    Parts[Bone.B]

                if A and B then

                    local AP,AV =
                        WorldToScreen(
                            A.Position
                        )

                    local BP,BV =
                        WorldToScreen(
                            B.Position
                        )

                    if AV and BV then

                        Bone.Line.BackgroundColor3 =
                            Config.Visual.Color

                        UpdateLine(
                            Bone.Line,
                            AP,
                            BP
                        )

                    else

                        Bone.Line.Visible =
                            false

                    end

                else

                    Bone.Line.Visible =
                        false

                end
            end
        end

        ----------------------------------------------------
        -- TRACER
        ----------------------------------------------------

        if Data.Tracer then

            local Point,Visible =
                Camera:WorldToViewportPoint(
                    Root.Position
                )

            if Visible and Point.Z > 0 then

                local Start =
                    Vector2.new(
                        Camera.ViewportSize.X/2,
                        Camera.ViewportSize.Y
                    )

                local End =
                    Vector2.new(
                        Point.X,
                        Point.Y
                    )

                Data.Tracer.BackgroundColor3 =
                    Config.Visual.Color

                UpdateLine(
                    Data.Tracer,
                    Start,
                    End
                )

            else

                Data.Tracer.Visible = false

            end
        end
    end
end)

