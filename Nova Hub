task.spawn(function()
    -- ============================================================
    -- NOVA HUB - TRANSIÇÃO FLUIDA v4.5.4
    -- O bloco visual inteiro da Loading sai junto com a transição.
    -- Durante o carregamento, N e barra continuam exatamente iguais.
    -- ============================================================

    for _, Particle in ipairs(Particles) do
        task.spawn(function()
            while LoadingScreen.Parent do
                pcall(function()
                    Tween(
                        Particle,
                        {
                            Position = UDim2.new(math.random(), 0, math.random(), 0),
                            BackgroundTransparency = math.random(50, 90) / 100
                        },
                        TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
                    )
                end)
                task.wait(2)
            end
        end)
    end

    task.spawn(function()
        while LoadingScreen.Parent do
            Tween(
                LoadingLogo,
                {Size = UDim2.fromOffset(86,86)},
                TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            )
            task.wait(0.55)

            Tween(
                LoadingLogo,
                {Size = UDim2.fromOffset(80,80)},
                TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            )
            task.wait(0.55)
        end
    end)

    local Statuses = {
        "Carregando...",
        "Inicializando...",
        "Configurando...",
        "Quase pronto..."
    }

    for _, Status in ipairs(Statuses) do
        LoadingStatus.Text = Status
        task.wait(0.55)
    end

    local BarTween = Tween(
        LoadingBarFill,
        {Size = UDim2.new(1,0,1,0)},
        TweenInfo.new(1.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    )

    if BarTween then
        BarTween.Completed:Wait()
    end

    -- Ao chegar em "Pronto!", a Loading começa imediatamente
    -- seu desaparecimento suave de 2 segundos.
    LoadingStatus.Text = "Pronto!"

    local Scale = Config.Customization.UIScale
    local FinalWidth = 420 * Scale
    local FinalHeight = 370 * Scale

    Main.Visible = true
    Main.AnchorPoint = Vector2.new(0.5,0.5)
    Main.Position = UDim2.new(0.5,0,0.5,12)
    Main.Size = UDim2.fromOffset(FinalWidth * 0.94, FinalHeight * 0.94)
    Main.BackgroundTransparency = 1

    local TransitionInfo = TweenInfo.new(
        0.72,
        Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out
    )

    -- O Main e o container da Loading começam no mesmo instante.
    local MainEnter = Tween(
        Main,
        {
            Size = UDim2.fromOffset(FinalWidth, FinalHeight),
            Position = UDim2.new(0.5,0,0.5,0),
            BackgroundTransparency = 0
        },
        TransitionInfo
    )

    -- A Loading inteira sai como UMA unidade.
    -- Isso inclui automaticamente:
    -- • fundo
    -- • N e fundo do N
    -- • barra e preenchimento
    -- • borda/glow da barra
    -- • textos
    -- • partículas
    --
    -- Assim nenhum elemento fica sobrando por ~1 segundo.
    -- Saída simples e elegante:
    -- a Loading apenas fica invisível suavemente, sem zoom/escala.
    -- Depois que o fade termina, o grupo é destruído.
    local LoadingFade = Tween(
        LoadingFadeGroup,
        {
            GroupTransparency = 1
        },
        TweenInfo.new(
            2,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        )
    )

    -- Tween() já chama :Play(); somente aguardamos a entrada do Main.
    if MainEnter then
        MainEnter.Completed:Wait()
    end

    -- Espera o fade da Loading terminar antes de destruir.
    if LoadingFade then
        LoadingFade.Completed:Wait()
    end

    Main.Position = UDim2.new(0.5,0,0.5,0)
    Main.Size = UDim2.fromOffset(FinalWidth, FinalHeight)
    Main.BackgroundTransparency = 0

    if LoadingFadeGroup and LoadingFadeGroup.Parent then
        LoadingFadeGroup:Destroy()
    elseif LoadingScreen.Parent then
        LoadingScreen:Destroy()
    end
end)

