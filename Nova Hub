    local prevCorner = Instance.new("UICorner"); prevCorner.CornerRadius = UDim.new(1,0); prevCorner.Parent = Preview

    -- small indicator to show selection border
    local previewBorder = Instance.new("UIStroke"); previewBorder.Color = Color3.new(0,0,0); previewBorder.Thickness = 1; previewBorder.Parent = Preview

    local function openPicker()
        ClosePopup()
        local PopupW, PopupH = 320, 260
        local Popup = MakePopup(PopupW, PopupH)
        -- position near row (but keep in screen)
        local x = math.clamp(Row.AbsolutePosition.X + (Row.AbsoluteSize.X - PopupW), 8, math.max(8, workspace.CurrentCamera.ViewportSize.X - PopupW - 8))
        local y = math.clamp(Row.AbsolutePosition.Y + Row.AbsoluteSize.Y + 6, 8, math.max(8, workspace.CurrentCamera.ViewportSize.Y - PopupH - 8))
        Popup.Position = UDim2.fromOffset(x,y)

        -- left: swatch grid
        local GridLeft = Instance.new("Frame")
        GridLeft.Size = UDim2.fromOffset(200,160)
        GridLeft.Position = UDim2.fromOffset(10,10)
        GridLeft.BackgroundTransparency = 1
        GridLeft.Parent = Popup

        -- grid generation: hues x saturations
        local cols = 10
        local rows = 8
        local sw = 200 / cols
        local sh = 160 / rows

        local currentHSV = {Color3.toHSV(Current)} -- h,s,v
        local selectedColor = Current

        local function selectColor(color)
            selectedColor = color
            Preview.BackgroundColor3 = color
        end

        for r = 1, rows do
            for c = 1, cols do
                local hue = (c - 1) / (cols - 1) -- 0..1
                local sat = 1 - ((r - 1) / (rows - 1)) * 0.95 -- top is high sat
                local col3 = Color3.fromHSV(hue, sat, 1)
                local swatch = Instance.new("TextButton")
