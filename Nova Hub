        end, function(v) return string.format("%.2f", v) end)
        Dropdown(Scroll, "Accent Color", {"Padrão","Roxo","Azul","Verde"}, "Padrão", function(v)
            if v == "Padrão" then
                Config.UI.Accent = Color3.fromRGB(105,108,145)
            elseif v == "Roxo" then
                Config.UI.Accent = Color3.fromRGB(170,100,220)
            elseif v == "Azul" then
                Config.UI.Accent = Color3.fromRGB(105,150,255)
