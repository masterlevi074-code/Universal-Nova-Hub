    Player.CharacterAdded:Connect(function()

        task.wait(.3)

        if Config.Visual.ESP then
            CreateESP(Player)
        end

    end)

    Player:GetPropertyChangedSignal(
        "Team"
    ):Connect(function()

        if Config.Visual.ESP then
            RefreshESP()
        end

    end)
end

