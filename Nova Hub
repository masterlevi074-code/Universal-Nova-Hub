    table.insert(ToggleRenderers,Render)

    Button.MouseButton1Click:Connect(function()
        State = not State
        Render()

        Tween(Button,{Size = UDim2.fromOffset(43,24)},TweenFast)
        task.delay(.07,function()
            if Button.Parent then
                Tween(Button,{Size = UDim2.fromOffset(40,22)},TweenFast)
            end
        end)

        if Callback then
            Callback(State)
        end
    end)

    Render()
    return Row
