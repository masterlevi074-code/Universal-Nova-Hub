local function RefreshESP()
    for Player in pairs(ESPData) do
        RemoveESP(Player)
    end

    if not Config.Visual.ESP then return end

    for _,Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            CreateESP(Player)
        end
    end
end

