    --------------------------------------------------------
    -- BOX
    --------------------------------------------------------

    if Config.Visual.Box then

        local Box =
            Instance.new("Frame")

        Box.Name = "NovaBox"
        Box.AnchorPoint =
            Vector2.new(.5,.5)

        Box.BackgroundTransparency = 1
        Box.BorderSizePixel = 0
        Box.Visible = false
