    {"Head","Torso"},
    {"Torso","Left Arm"},
    {"Torso","Right Arm"},
    {"Torso","Left Leg"},
    {"Torso","Right Leg"}
}

local function CreateSkeletonLine(parent)
    local line = Instance.new("Frame")
    line.Name = "Bone"
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = Config.Visual.Color
    line.BorderSizePixel = 0
    line.Size = UDim2.fromOffset(0, Config.Visual.SkeletonThickness)
    line.Visible = false
    line.Parent = parent
    return line
end

local function CreateSkeleton(player)
    if player == LocalPlayer then return end
    if Skeletons[player] then
        Skeletons[player].Folder:Destroy()
        Skeletons[player] = nil
    end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local folder = Instance.new("Folder")
    folder.Name = player.Name .. "_Skeleton"
    folder.Parent = ESPGui
    local connections
    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        connections = R15Skeleton
    else
        connections = R6Skeleton
    end
    local bones = {}
    for index, connection in ipairs(connections) do
        local part1 = character:FindFirstChild(connection[1])
        local part2 = character:FindFirstChild(connection[2])
        if part1 and part2 then
            local line = CreateSkeletonLine(folder)
            bones[index] = {
                Line = line,
                Part1 = part1,
                Part2 = part2,
            }
        end
    end
    Skeletons[player] = {
        Character = character,
        Folder = folder,
        Bones = bones,
    }
    return true
end

local function RemoveSkeleton(player)
    local data = Skeletons[player]
    if not data then return end
    if data.Folder then
        data.Folder:Destroy()
    end
    Skeletons[player] = nil
end

local function CreateESP(Player)
    if Player == LocalPlayer then return false end
    if not Player or not Player.Parent then return false end

