    Number.TextColor3 = Color3.fromRGB(180,183,194)
    Number.TextSize = 8
    Number.Font = Enum.Font.Gotham
    Number.TextXAlignment = Enum.TextXAlignment.Center
    Number.TextYAlignment = Enum.TextYAlignment.Center
    Number.Parent = Row

    local NumberCorner = Instance.new("UICorner")
    NumberCorner.CornerRadius = UDim.new(0,5)
    NumberCorner.Parent = Number

    local Bar = Instance.new("TextButton")
    Bar.Size = UDim2.new(1,-24,0,6)
    Bar.Position = UDim2.fromOffset(12,40)
    Bar.BackgroundColor3 = Color3.fromRGB(38,40,48)
    Bar.Text = ""
    Bar.AutoButtonColor = false
    Bar.Parent = Row

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1,0)
    BarCorner.Parent = Bar

    local Fill = Instance.new("Frame")
    Fill.BackgroundColor3 = Accent()
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1,0)
    FillCorner.Parent = Fill

    local function UpdateAccent()
        if Fill.Parent then Fill.BackgroundColor3 = Accent() end
    end
    table.insert(ToggleRenderers,UpdateAccent)

    local Dragging = false

    local function Set(Input)
        local Percent = math.clamp((Input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local NewValue = Min + (Max-Min)*Percent
        Fill.Size = UDim2.fromScale(Percent,1)
        if Format and type(Format) == "function" then
            Number.Text = Format(NewValue)
        else
            Number.Text = string.format("%.2f",NewValue)
        end
        if Callback and type(Callback) == "function" then
            Callback(NewValue)
        end
    end

    Bar.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            PlayClickSound()
            Dragging = true
            Set(Input)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            Set(Input)
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    local Percent = math.clamp((Value-Min)/(Max-Min), 0, 1)
    Fill.Size = UDim2.fromScale(Percent,1)
    if Format and type(Format) == "function" then
        Number.Text = Format(Value)
    else
        Number.Text = string.format("%.2f",Value)
    end

    return Row
end

