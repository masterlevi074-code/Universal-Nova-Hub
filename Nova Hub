local function UpdateTargetHighlight(Target)
    if not Config.Aim.TargetHighlight or not Target then TargetHighlight.Enabled = false; return end
    local Character = Target.Parent
    if not Character then TargetHighlight.Enabled = false; return end
    TargetHighlight.Adornee = Character
    TargetHighlight.FillColor = Config.Aim.Color
    TargetHighlight.OutlineColor = Config.Aim.Color
    TargetHighlight.Enabled = true
end

RunService:BindToRenderStep("NovaAim", Enum.RenderPriority.Camera.Value+1, function()
    local Target = nil
    if Config.Aim.Enabled then Target = GetTarget() end
    CurrentTarget = Target
    UpdateTargetHighlight(Target)
    if not Target then return end

    local Position = Target.Position
    if Config.Aim.Prediction then
        local Root = Target.Parent:FindFirstChild("HumanoidRootPart")
        if Root then Position += Root.AssemblyLinearVelocity * Config.Aim.PredictionStrength end
    end

    local Desired = CFrame.lookAt(Camera.CFrame.Position, Position)
    Camera.CFrame = Camera.CFrame:Lerp(Desired, Config.Aim.Smoothness)
end)

