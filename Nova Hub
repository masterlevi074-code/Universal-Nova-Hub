    Stroke.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1,-60,0,18)
    Label.Position = UDim2.fromOffset(12,5)
    Label.BackgroundTransparency = 1
    Label.Text = Title
    Label.TextColor3 = Color3.fromRGB(230,231,237)
    Label.TextSize = 9
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local Number = Instance.new("TextLabel")
    Number.Size = UDim2.fromOffset(50,20)
    Number.Position = UDim2.new(1,-62,0,4)
    Number.BackgroundColor3 = Color3.fromRGB(35,37,45)
    Number.TextColor3 = Color3.fromRGB(180,183,194)
    Number.TextSize = 8
    Number.Font = Enum.Font.GothamBold
    Number.TextXAlignment = Enum.TextXAlignment.Center
    Number.TextYAlignment = Enum.TextYAlignment.Center
    Number.Parent = Row

    local NumberCorner = Instance.new("UICorner")
    NumberCorner.CornerRadius = UDim.new(0,5)
    NumberCorner.Parent = Number

    local Bar = Instance.new("TextButton")
    Bar.Size = UDim2.new(1,-24,0,6)
    Bar.Position = UDim2.fromOffset(12,40)
    Bar.BackgroundColor3 = Color3.fromRGB(38,40,48)
    Bar.Text = ""
    Bar.AutoButtonColor = false
    Bar.Parent = Row

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(1,0)
    BarCorner.Parent = Bar

    local Fill = Instance.new("Frame")
    Fill.BackgroundColor3 = Accent()
    Fill.BorderSizePixel = 0
    Fill.Parent = Bar

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1,0)
    FillCorner.Parent = Fill

    local function UpdateAccent()
        if Fill.Parent then
            Fill.BackgroundColor3 = Accent()
        end
    end

    table.insert(ToggleRenderers,UpdateAccent)

    local Dragging = false

    local function Set(Input)
        if not Bar.AbsoluteSize or Bar.AbsoluteSize.X <= 0 then return end
        local px = Input.Position and Input.Position.X or (UserInputService:GetMouseLocation().X)
        local Percent = math.clamp((px - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local NewValue = Min + (Max-Min)*Percent

        Fill.Size = UDim2.fromScale(Percent,1)

        if Format then
            Number.Text = Format(NewValue)
        else
            Number.Text = string.format("%.2f",NewValue)
        end

        if Callback then
            pcall(Callback, NewValue)
        end
    end

    local conn1 = Bar.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            PlayClickSound()
            Dragging = true
            Set(Input)
        end
    end)
    AddConn(conn1)

    local conn2 = UserInputService.InputChanged:Connect(function(Input)
        if not Dragging then return end
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            Set(Input)
        end
    end)
    AddConn(conn2)

    local conn3 = UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)
    AddConn(conn3)

    local Percent = 0
    if Max ~= Min then
        Percent = math.clamp((Value-Min)/(Max-Min), 0, 1)
    end
    Fill.Size = UDim2.fromScale(Percent,1)

    if Format then
        Number.Text = Format(Value)
    else
        Number.Text = string.format("%.2f",Value)
    end

    return Row
end

local function Dropdown(Parent, Title, Options, Current, Callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1,-2,0,44)
    Row.BackgroundColor3 = PanelColor()
    Row.BorderSizePixel = 0
    Row.Parent = Parent

    local Corner = Instance.new("UICorner")
