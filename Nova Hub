local prevHUDSize = Config.HUD.Size

local function UpdateHUDAppearance()
    local oldSize = prevHUDSize or Config.HUD.Size
    local newSize = math.floor(Config.HUD.Size or oldSize)
    local delta = newSize - oldSize

    HUDFrame.Size = UDim2.fromOffset(newSize, 50)

    local pos = HUDFrame.Position
    HUDFrame.Position = UDim2.new(pos.X.Scale, pos.X.Offset - math.floor(delta/2), pos.Y.Scale, pos.Y.Offset)

    HUDFrame.BackgroundTransparency = Config.HUD.Transparency
    HUDStroke.Transparency = Config.HUD.Transparency
    HUDText.TextTransparency = Config.HUD.Transparency

    local textSize = math.clamp(math.floor(newSize/13), 7, 32)
    HUDText.TextSize = textSize

    prevHUDSize = newSize
end

