-- AIM UPDATE
------------------------------------------------------------

RunService.RenderStepped:Connect(function()

    UpdateFov()

    if not Config.Aim.Enabled then

        CurrentTarget = nil

        return
    end

    CurrentTarget =
        GetTarget()

end)

