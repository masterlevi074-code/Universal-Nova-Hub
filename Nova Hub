local function SetActiveTab(Button, Name)
    if ActiveTab == Button then return end
    ActiveTab = Button
    -- reset all styles
    for _,b in pairs(TabButtons) do
        Tween(b, {BackgroundColor3 = Color3.fromRGB(18,19,24), TextColor3 = Color3.fromRGB(130,133,143)}, TweenFast)
    end
    -- style active
    Tween(Button, {BackgroundColor3 = Color3.fromRGB(28,30,38), TextColor3 = Color3.new(1,1,1)}, TweenFast)

    -- atualizar conteúdo conforme aba
    PageTitle.Text = Name

    -- limpar Scroll
    for _,child in ipairs(Scroll:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    -- popular com controles básicos por aba
    if Name == "Aim Assist" or Name == "Aim" or Name == "◎" then
        Toggle(Scroll, "Aim Assist", "Enable aim assist", Config.Aim.Enabled, function(v)
            Config.Aim.Enabled = v
            RefreshToggleAccent()
        end)
        Toggle(Scroll, "Mostrar FOV", "Exibir círculo de FOV", Config.Aim.FOVEnabled, function(v)
            Config.Aim.FOVEnabled = v
            UpdateFov()
        end)
        Slider(Scroll, "FOV", 20, 200, Config.Aim.FOV, function(v)
            Config.Aim.FOV = v
            UpdateFov()
        end, function(v) return string.format("%.0f", v) end)
        Slider(Scroll, "Espessura FOV", 1, 8, Config.Aim.Thickness, function(v)
            Config.Aim.Thickness = v
            UpdateFov()
        end, function(v) return string.format("%.0f", v) end)
        Dropdown(Scroll, "Target Part", {"Head","UpperTorso","HumanoidRootPart"}, Config.Aim.TargetPart, function(v)
            Config.Aim.TargetPart = v
        end)
    elseif Name == "Visual" or Name == "◉" then
        Toggle(Scroll, "ESP", "Mostrar ESP", Config.Visual.ESP, function(v) Config.Visual.ESP = v end)
        Toggle(Scroll, "Caixas", "Exibir boxes", Config.Visual.Box, function(v) Config.Visual.Box = v end)
        Slider(Scroll, "Max Distance", 100, 3000, Config.Visual.MaxDistance, function(v) Config.Visual.MaxDistance = v end, function(v) return string.format("%.0f", v) end)
    elseif Name == "Player" or Name == "👤" then
        Toggle(Scroll, "Speed Hack", "Aumentar velocidade do jogador", Config.Player.SpeedHack, function(v) Config.Player.SpeedHack = v end)
        Slider(Scroll, "Speed Multiplier", 1, 10, Config.Player.SpeedMultiplier, function(v) Config.Player.SpeedMultiplier = v end, function(v) return string.format("%.2f", v) end)
        Toggle(Scroll, "Infinite Jump", "Permite pular indefinidamente", Config.Player.InfiniteJump, function(v) Config.Player.InfiniteJump = v end)
    elseif Name == "World" or Name == "🌍" then
        Toggle(Scroll, "Full Bright", "Remover iluminação", Config.World.FullBright, function(v)
            Config.World.FullBright = v
            if v then
                Lighting.Brightness = 10
            else
                Lighting.Brightness = Config.World.Brightness
            end
        end)
        Toggle(Scroll, "Remove Fog", "Remover neblina", Config.World.RemoveFog, function(v)
            Config.World.RemoveFog = v
            Lighting.FogEnd = v and 100000 or 100000 -- ajuste conforme necessário
        end)
        Slider(Scroll, "Brightness", 0, 10, Config.World.Brightness, function(v)
            Config.World.Brightness = v
            if not Config.World.FullBright then
                Lighting.Brightness = v
            end
        end, function(v) return string.format("%.1f", v) end)
        Slider(Scroll, "Time of Day", 0, 24, Config.World.TimeOfDay, function(v)
            Config.World.TimeOfDay = v
            Lighting.TimeOfDay = tostring(v)
        end, function(v) return string.format("%.0f:00", v) end)
    elseif Name == "Custom" or Name == "🎨" then
        Dropdown(Scroll, "Theme", {"Dark","Light"}, Config.Customization.UITheme, function(v)
            Config.Customization.UITheme = v
            -- aplicar tema simples
            if v == "Dark" then
                Main.BackgroundColor3 = DarkColor()
            else
                Main.BackgroundColor3 = Color3.fromRGB(240,240,240)
            end
        end)
        Slider(Scroll, "UIScale", 0.5, 2, Config.Customization.UIScale, function(v)
            Config.Customization.UIScale = v
