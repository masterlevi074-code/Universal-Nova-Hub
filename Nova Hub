local function SetMinimized(State)

    Minimized = State

    if State then

        Tween(
            Main,
            {
                Size = MinimizedSize
            },
            TweenSmooth
        )

        Tween(
            Sidebar,
            {
                Position =
                    UDim2.fromOffset(
                        -70,
                        46
                    )
            },
            TweenFast
        )

        Tween(
            Content,
            {
                Position =
                    UDim2.fromOffset(
                        60,
                        310
                    )
            },
            TweenFast
        )

        Minimize.Text = "+"

    else

        Tween(
            Main,
            {
                Size = NormalSize
            },
            TweenSmooth
        )

        Tween(
            Sidebar,
            {
                Position =
                    UDim2.fromOffset(
                        0,
                        46
                    )
            },
            TweenSmooth
        )

        Tween(
            Content,
            {
                Position =
                    UDim2.fromOffset(
                        60,
                        46
                    )
            },
            TweenSmooth
        )

        Minimize.Text = "—"

    end
