                end
            end)
            OptionButton.MouseLeave:Connect(function()
                if Option ~= Current then
                    Tween(OptionButton,{BackgroundColor3 = Color3.fromRGB(28,30,38)})
                end
            end)

            OptionButton.MouseButton1Click:Connect(function()
                PlayClickSound()
                Current = Option
                Button.Text = Option.." ▼"
                ClosePopup()
                if Callback then Callback(Option) end
            end)
        end
    end)

    return Row
end

