-- FPS / HUD
local Frames = 0
local Elapsed = 0
local FPS = 60
local SessionStart = os.time()
local ServerName = game.JobId:sub(1, 8)

RunService.RenderStepped:Connect(function(DT)
    UpdateFly()

    Frames += 1
    Elapsed += DT
    if Elapsed >= 1 then
        FPS = Frames
        Frames = 0
        Elapsed = 0
    end
    if not Config.HUD.Enabled then return end
    local Lines = {}
    if Config.HUD.FPS then table.insert(Lines, "FPS: "..FPS) end
    if Config.HUD.Ping then
        local Ping = "?"
        pcall(function()
            Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        table.insert(Lines, "Ping: "..Ping.."ms")
        QuickPing.Text = "Ping: "..Ping.."ms"
    end
    if Config.HUD.Players then
        table.insert(Lines, "Players: "..#Players:GetPlayers())
        QuickPlayers.Text = "Players: "..#Players:GetPlayers()
    end
    if Config.HUD.XYZ then
        local Character = LocalPlayer.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if Root then
            local Position = Root.Position
            table.insert(Lines, string.format("XYZ: %.0f, %.0f, %.0f", Position.X, Position.Y, Position.Z))
        end
    end
    if Config.HUD.ShowTime then
        table.insert(Lines, "Time: "..os.date("%H:%M:%S"))
    end
    if Config.HUD.ShowServer then
        table.insert(Lines, "Server: "..ServerName)
    end
    if Config.HUD.ShowSessionTime then
        local SessionTime = os.time() - SessionStart
        local Hours = math.floor(SessionTime / 3600)
        local Minutes = math.floor((SessionTime % 3600) / 60)
        local Seconds = SessionTime % 60
        table.insert(Lines, string.format("Session: %02d:%02d:%02d", Hours, Minutes, Seconds))
        QuickSession.Text = string.format("Session: %02d:%02d", Minutes, Seconds)
    end
    QuickFPS.Text = "FPS: "..FPS
    HUDText.Text = table.concat(Lines, "\n")
    local numLines = #Lines
    if numLines > 0 then
        local textHeight = numLines * 10
        local newHeight = textHeight + 6
        HUDFrame.Size = UDim2.fromOffset(Config.HUD.Size, newHeight)
        HUDText.Size = UDim2.new(1,-12,0,textHeight)
        HUDText.Position = UDim2.fromOffset(6, 3)
    else
        HUDFrame.Size = UDim2.fromOffset(Config.HUD.Size, 25)
    end
end)

-- PLAYER EVENTS
local PlayerConnections = {}

local function DisconnectPlayerESPEvents(Player)
    local Connections = PlayerConnections[Player]
    if Connections then
        for _, Connection in ipairs(Connections) do
            if Connection then Connection:Disconnect() end
        end
        PlayerConnections[Player] = nil
    end
end

local function BuildESPImmediately(Player, Character)
    if Player == LocalPlayer then return end
    if not Config.Visual.ESP then return end
    if not Character or Player.Character ~= Character then return end

    CreateESP(Player)

    if not ESPData[Player] then
        task.spawn(function()
            for _ = 1, 12 do
                if not Config.Visual.ESP then return end
                if Player.Character ~= Character then return end

                RunService.Heartbeat:Wait()

                if Character.Parent
                    and Character:FindFirstChild("HumanoidRootPart")
                    and Character:FindFirstChild("Head")
                    and Character:FindFirstChildOfClass("Humanoid") then

                    CreateESP(Player)
                    if ESPData[Player] then
                        return
                    end
                end
            end
        end)
    end
end

local function SetupPlayer(Player)
    if Player == LocalPlayer then return end

    DisconnectPlayerESPEvents(Player)

    local Connections = {}
    PlayerConnections[Player] = Connections

    table.insert(Connections, Player.CharacterAdded:Connect(function(Character)
        RemoveESP(Player)
        RemoveSkeleton(Player)
        BuildESPImmediately(Player, Character)
    end))

    table.insert(Connections, Player.CharacterRemoving:Connect(function()
        RemoveESP(Player)
        RemoveSkeleton(Player)
    end))

    table.insert(Connections, Player:GetPropertyChangedSignal("Team"):Connect(function()
        if Config.Visual.ESP then
            CreateESP(Player)
        else
            RemoveESP(Player)
        end
    end))

    if Player.Character then
        BuildESPImmediately(Player, Player.Character)
    end
end

for _,Player in ipairs(Players:GetPlayers()) do
    SetupPlayer(Player)
end

Players.PlayerAdded:Connect(SetupPlayer)
Players.PlayerRemoving:Connect(function(Player)
    DisconnectPlayerESPEvents(Player)
    RemoveESP(Player)
    RemoveSkeleton(Player)
end)

