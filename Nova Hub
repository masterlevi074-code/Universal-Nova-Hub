local ESPData = {}

local function IsTeammate(Player)

    return
        Config.Visual.TeamCheck
        and LocalPlayer.Team ~= nil
        and Player.Team ==
            LocalPlayer.Team
end

local function RemoveESP(Player)

    local Data =
        ESPData[Player]

    if not Data then
        return
    end

    for _,Object in pairs(Data) do

        if typeof(Object) == "Instance" then
            Object:Destroy()
        end
    end

    ESPData[Player] = nil
end

local ESPGui =
    Instance.new("ScreenGui")

ESPGui.Name =
    "NovaESP"

ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.DisplayOrder = 80
ESPGui.Parent = PlayerGui

local function CreateLine(Parent)

    local Line =
        Instance.new("Frame")

    Line.AnchorPoint =
        Vector2.new(.5,.5)

    Line.BorderSizePixel = 0

    Line.BackgroundColor3 =
        Config.Visual.Color

    Line.Visible = false
    Line.Parent = Parent

    return Line
end

local function UpdateLine(Line,A,B)

    local Delta =
        B-A

    Line.Position =
        UDim2.fromOffset(
            (A.X+B.X)/2,
            (A.Y+B.Y)/2
        )

    Line.Size =
        UDim2.fromOffset(
            Delta.Magnitude,
            2
        )

    Line.Rotation =
        math.deg(
            math.atan2(
                Delta.Y,
                Delta.X
            )
        )

    Line.Visible = true
end

